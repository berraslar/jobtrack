# Bu dosyayı elle doldurmak yerine şunu çalıştırın:  ./scripts/init-env.sh
# Tüm değişkenler zorunludur; varsayılan parola yoktur (A02).

POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
# base64, 32 bayt:  openssl rand -base64 32
APP_SECRET=
DATA_ENCRYPTION_KEY=

APP_ORIGIN=http://localhost:8080
# Üretimde alan adı (örn. jobtrack.example.com). Boş bırakılırsa http://localhost:8080
SITE_ADDRESS=
REGISTRATION_ENABLED=false
HIBP_ENABLED=true
LOG_LEVEL=info

# ADR-0007: doğrulama kodları. Boşsa yerel Mailpit (http://localhost:8025).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#        SMTP_USER=adiniz@gmail.com SMTP_PASSWORD=<uygulama şifresi> MAIL_FROM="JobTrack <adiniz@gmail.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ADR-0010: yapay zekâ ile CV uyarlama. Varsayılan kapalı (boş). Açarsanız maskelenmiş CV ve
# ilan metni Google'a gönderilir; ücretsiz katmanda Google bu veriyi ürünlerini geliştirmek için
# kullanabilir. Anahtar: https://aistudio.google.com/app/apikey (README'deki adımlar).
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ana model yoğunken (503) beklemeden sırayla denenen yedek modeller.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
